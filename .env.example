# Variables d'environnement — copier en .env.local et remplir.
# Ne jamais commiter le vrai .env.local

# Supabase (obligatoire pour /api/produits et la page produit /p/[id])
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# IA — fournisseur principal
NVIDIA_API_KEY=
# IA — secours automatique si NVIDIA échoue
GEMINI_API_KEY=

# --- Dictée vocale (vocal WhatsApp) ---
# Renseignez AU MOINS UNE de ces clés, sinon /api/transcrire répond 503
# et la dictée wolof est indisponible.

# Groq (recommandé) : whisper-large-v3, rapide et bon en wolof.
# Clé : https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI (alternative) : gpt-4o-mini-transcribe
OPENAI_API_KEY=

# Langue demandée à Whisper (code ISO). "wol" = wolof.
TRANSCRIPTION_LANGUAGE=wol

# Optionnel : serveur GPU NVIDIA Brev d'Amina, prioritaire sur les APIs.
# Exemple : https://xxxx-8000.<region>.brev.dev
TRANSCRIPTION_URL=
