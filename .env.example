# Variables d'environnement — copier en .env.local et remplir.
# Ne jamais commiter le vrai .env.local

# Supabase (obligatoire pour /api/produits et la page produit /p/[id])
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# IA — fournisseur principal
NVIDIA_API_KEY=
# IA — secours automatique si NVIDIA échoue
GEMINI_API_KEY=

# Dictée vocale (audio WhatsApp) : URL du serveur GPU qui expose /transcrire
# Exemple : https://xxxxbrev-8000.<id>.brev.dev
# Sans cette variable, /api/transcrire répond 503 et la dictée est désactivée.
TRANSCRIPTION_URL=
